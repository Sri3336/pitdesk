# PitDesk external-hosting configuration — values are set only in the host's secret manager.
# Never commit an .env file containing production values.

# Core application
NODE_ENV=production
PORT=3000
APP_URL=https://staging.pitdesk.ai
PITDESK_EXTERNAL_HOST=true
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
EXTERNAL_LLM_BASE_URL=https://api.openai.com/v1
EXTERNAL_LLM_API_KEY=replace-with-your-openai-compatible-provider-key
EXTERNAL_ASSET_BASE_URL=https://assets.example.com/pitdesk
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=PitDesk Alerts <alerts@your-domain.example>
JWT_SECRET=replace-with-a-strong-random-secret

# Authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Brokerage and market data
TRADIER_API_KEY=
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=

# AI, email, and notifications
LLM_PROVIDER=
LLM_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Independent object storage for uploads, media, and database backups
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Job runner
CRON_TIMEZONE=America/New_York
